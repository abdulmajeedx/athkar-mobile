<?xml version="1.0" encoding="utf-8"?>
<!--
  API 26-30 full-backup rules. These versions have no device-transfer concept, so this covers cloud
  backup only, and carries nothing: the encrypted database is useless without the hardware-bound
  Keystore key that never leaves the device, and everything else is either derivable or sensitive
  (STRIDE surface S3, backup/cloud leakage).
-->
<full-backup-content>
    <exclude domain="root" path="." />
</full-backup-content>
