<?xml version="1.0" encoding="utf-8"?>
<!-- Same sensitive-data exclusion as backup_rules.xml, applied to API 31+ data extraction. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="athkar.db" />
        <exclude domain="database" path="athkar.db-wal" />
        <exclude domain="database" path="athkar.db-shm" />
        <exclude domain="sharedpref" path="athkar_session.xml" />
        <exclude domain="file" path="cache/" />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="athkar_session.xml" />
        <include domain="file" path="adhkar" />
    </device-transfer>
</data-extraction-rules>
