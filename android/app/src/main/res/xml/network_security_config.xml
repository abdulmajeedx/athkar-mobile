<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is prohibited. TLS 1.3 required with certificate pinning enforced in code
  (NetworkSecurityConfig cannot express SPKI pinning with a pin-set kill switch, which is done
  dynamically in the Ktor OkHttp engine). This file only forbids cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
