<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app does no networking at all: the adhkar are bundled in the APK and every prayer
         time, qibla bearing and solar position is computed on the device. There is deliberately
         no INTERNET permission, so there is nothing for a Play data-safety declaration to
         disclose beyond what never leaves the phone. -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Coarse location only. A few hundred metres of error moves a prayer time by well under a
         second and the qibla by a fraction of a degree, so precise location would buy the user
         nothing while costing them privacy and the app a Play policy review. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The qibla compass needs a magnetometer; the app degrades to a static bearing without one. -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Prayer alerts must land at the minute, not "within the hour" as Doze would otherwise
         batch them. Requested rather than USE_EXACT_ALARM so the user stays in control, with an
         inexact fallback if they decline. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The adhan runs for two and a half minutes, which is far longer than a broadcast receiver
         lives. It is played by a foreground service instead, and these three permissions are what
         that costs. All are install-time and none reach the network. WAKE_LOCK is required by
         MediaPlayer.setWakeMode, and is what keeps the audio going with the screen off; every lock
         this app takes is acquired with a timeout so a bug cannot drain a battery. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".AthkarApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Athkar"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A private scheme, not an App Link: verified https links would require owning and
                 serving assetlinks.json from a domain, and an unowned autoVerify host fails
                 verification silently while claiming an association that is not ours. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="athkar" android:host="adhkar" />
            </intent-filter>
        </activity>

        <!-- Fires at each prayer time: posts the alert and re-registers the next window. -->
        <receiver
            android:name=".notifications.PrayerAlarmReceiver"
            android:exported="false" />

        <!-- Plays the adhan. Typed mediaPlayback because that is precisely what it does — it
             decodes one audio file to the speaker under a MediaSession, and nothing else. The type
             carries no platform timeout, unlike shortService, whose three-minute cliff sits barely
             twenty seconds past the end of the recording. It must never be started from
             BOOT_COMPLETED: apps targeting Android 15 may not launch a mediaPlayback service from
             a boot broadcast, and SystemEventReceiver only re-registers alarms for that reason. -->
        <service
            android:name=".notifications.AdhanPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Re-registers alarms after the events that wipe them. -->
        <receiver
            android:name=".notifications.SystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <!-- Android 12+. Revoking the exact-alarm permission deletes every exact alarm the
                     app has registered, silently and without reopening it. This is the only
                     notice given, and without it the alerts simply stop. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
